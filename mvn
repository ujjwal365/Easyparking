#!/usr/bin/env bash
# SMART PARKING GARAGE - Maven Wrapper Launcher for Bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
if [ -z "$JAVA_HOME" ]; then
    if [ -d "C:/Program Files/Java/jdk-26.0.2" ]; then
        export JAVA_HOME="C:/Program Files/Java/jdk-26.0.2"
    fi
fi
export PATH="$JAVA_HOME/bin:$PATH"
exec "$DIR/maven/apache-maven-3.9.6/bin/mvn" -Dmaven.repo.local="$DIR/.m2/repository" "$@"
